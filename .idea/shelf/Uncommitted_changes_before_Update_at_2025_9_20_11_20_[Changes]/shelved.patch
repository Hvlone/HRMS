+        buttons.forEach(button => {
+            button.addEventListener('click', () => {
+                // 移除所有按钮的活跃状态
+                buttons.forEach(btn => {
+                    btn.classList.remove('active', 'border-bear-brown', 'bg-bear-cream/50');
+                    btn.classList.add('border-gray-200');
+                });

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.AppointmentMapper">
    <resultMap id="AppointmentResultMap" type="Appointment">
        <id property="appointId" column="appoint_id"/>
        <result property="houseId" column="house_id"/>
        <result property="tenantId" column="tenant_id"/>
        <result property="appointTime" column="appoint_time"/>
        <result property="status" column="status"
                typeHandler="org.apache.ibatis.type.EnumTypeHandler"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <!-- 根据租客ID查询 -->
    <select id="selectByTenantId" resultMap="AppointmentResultMap">
        SELECT * FROM appointment
        WHERE tenant_id = #{tenantId}
        ORDER BY appoint_time DESC
    </select>

    <!-- 根据房源ID查询 -->
    <select id="selectByHouseId" resultMap="AppointmentResultMap">
        SELECT * FROM appointment
        WHERE house_id = #{houseId}
        ORDER BY appoint_time DESC
    </select>

</mapper>
    
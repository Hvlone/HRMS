<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.mapper.ReviewLikeMapper">

    <resultMap id="BaseResultMap" type="com.example.demo.po.ReviewLike">
        <id column="like_id" jdbcType="INTEGER" property="likeId"/>
        <result column="review_id" jdbcType="INTEGER" property="reviewId"/>
        <result column="user_id" jdbcType="INTEGER" property="userId"/>
        <result column="like_time" jdbcType="TIMESTAMP" property="likeTime"/>
    </resultMap>

    <sql id="BaseColumns">
        like_id, review_id, user_id, like_time
    </sql>

    <!-- 插入 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="likeId"
            parameterType="com.example.demo.po.ReviewLike">
        INSERT INTO review_like (review_id, user_id, like_time)
        VALUES (#{reviewId}, #{userId}, #{likeTime})
    </insert>

    <!-- 主键查询 -->
    <select id="selectByPrimaryKey" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM review_like
        WHERE like_id = #{likeId}
    </select>

    <!-- 查询全部 -->
    <select id="selectAll" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM review_like
        ORDER BY like_id DESC
    </select>

    <!-- 根据评论ID查询 -->
    <select id="selectByReviewId" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM review_like
        WHERE review_id = #{reviewId}
        ORDER BY like_time DESC
    </select>

    <!-- 根据用户ID查询 -->
    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM review_like
        WHERE user_id = #{userId}
        ORDER BY like_time DESC
    </select>

    <!-- 判断用户是否已点赞 -->
    <select id="selectByReviewIdAndUserId" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM review_like
        WHERE review_id = #{reviewId}
        AND user_id = #{userId}
        LIMIT 1
    </select>

    <!-- 动态更新 -->
    <update id="updateByPrimaryKeySelective" parameterType="com.example.demo.po.ReviewLike">
        UPDATE review_like
        <set>
            <if test="reviewId != null">review_id = #{reviewId},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="likeTime != null">like_time = #{likeTime},</if>
        </set>
        WHERE like_id = #{likeId}
    </update>

    <!-- 主键删除 -->
    <delete id="deleteByPrimaryKey">
        DELETE FROM review_like WHERE like_id = #{likeId}
    </delete>

    <!-- 取消点赞 -->
    <delete id="deleteByReviewIdAndUserId">
        DELETE FROM review_like
        WHERE review_id = #{reviewId}
          AND user_id = #{userId}
    </delete>

</mapper>
<+><!DOCTYPE html>\r\n<html lang=\"zh-CN\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>小熊账号 - 注册</title>\r\n    <!-- 引入Tailwind CSS -->\r\n    <script src=\"https://cdn.tailwindcss.com\"></script>\r\n    <!-- 引入Font Awesome -->\r\n    <link href=\"https://cdn.jsdelivr.net/npm/font-awesome@4.7.0/css/font-awesome.min.css\" rel=\"stylesheet\">\r\n\r\n    <!-- 配置Tailwind自定义颜色 -->\r\n    <script>\r\n        tailwind.config = {\r\n            theme: {\r\n                extend: {\r\n                    colors: {\r\n                        bear: {\r\n                            50: '#FCF9F5',\r\n                            100: '#F9F2E9',\r\n                            200: '#F1E2D0',\r\n                            300: '#E6C8A0',\r\n                            400: '#D8A970',\r\n                            500: '#C88C45', // 主棕色\r\n                            600: '#B07230',\r\n                            700: '#8C5825',\r\n                            800: '#6D4520',\r\n                            900: '#57381C',\r\n                        }\r\n                    },\r\n                    fontFamily: {\r\n                        sans: ['Inter', 'system-ui', 'sans-serif'],\r\n                    },\r\n                },\r\n            }\r\n        }\r\n    </script>\r\n\r\n    <!-- 自定义工具类 -->\r\n    <style type=\"text/tailwindcss\">\r\n        @layer utilities {\r\n            .content-auto {\r\n                content-visibility: auto;\r\n            }\r\n            .bg-gradient-bear {\r\n                background: linear-gradient(135deg, #F9F2E9 0%, #E6C8A0 100%);\r\n            }\r\n            .transition-bear {\r\n                transition: all 0.3s ease;\r\n            }\r\n        }\r\n    </style>\r\n</head>\r\n\r\n<body class=\"min-h-screen bg-gray-50 font-sans text-gray-800 overflow-x-hidden\">\r\n<div class=\"flex flex-col md:flex-row min-h-screen\">\r\n    <!-- 左侧图片区域 -->\r\n    <div class=\"w-full md:w-1/2 bg-bear-100 relative overflow-hidden\">\r\n        <div class=\"absolute inset-0 bg-gradient-to-r from-bear-900/20 to-transparent z-10\"></div>\r\n\r\n        <div class=\"relative z-20 h-full flex items-center justify-center p-8\">\r\n            <img src=\"../../static/img/login_bg.png\"\r\n                 alt=\"可爱的小熊形象\">\r\n        </div>\r\n\r\n        <!-- 底部装饰文字 -->\r\n        <div class=\"absolute bottom-8 left-8 right-8 z-20 text-center md:text-left\">\r\n            <h2 class=\"text-2xl md:text-3xl font-bold text-bear-800 mb-2\">创建你的小熊账号</h2>\r\n            <p class=\"text-bear-700/80 max-w-md mx-auto md:mx-0\">加入我们的大家庭，享受专属小熊服务</p>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- 右侧注册表单区域 -->\r\n    <div class=\"w-full md:w-1/2 flex flex-col\">\r\n        <!-- 顶部品牌和链接 -->\r\n        <header class=\"pt-6 pb-12 px-8 md:px-16 flex justify-between items-center\">\r\n            <div class=\"flex items-center\">\r\n                <div class=\"w-10 h-10 rounded-full bg-bear-500 flex items-center justify-center mr-3\">\r\n                    <i class=\"fa fa-paw text-white text-xl\"></i>\r\n                </div>\r\n                <h1 class=\"text-xl font-bold text-bear-800\">小熊账号</h1>\r\n            </div>\r\n\r\n            <div class=\"hidden md:flex items-center space-x-6 text-sm\">\r\n                <a href=\"#\" class=\"text-gray-600 hover:text-bear-600 transition-bear\">用户协议</a>\r\n                <a href=\"#\" class=\"text-gray-600 hover:text-bear-600 transition-bear\">隐私政策</a>\r\n                <a href=\"#\" class=\"text-gray-600 hover:text-bear-600 transition-bear\">帮助中心</a>\r\n                <div class=\"relative group\">\r\n                    <button class=\"flex items-center text-gray-600 hover:text-bear-600 transition-bear\">\r\n                        中文(简体)\r\n                        <i class=\"fa fa-chevron-down ml-1 text-xs\"></i>\r\n                    </button>\r\n                    <div class=\"absolute right-0 mt-2 w-40 bg-white shadow-lg rounded-md overflow-hidden opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-10\">\r\n                        <a href=\"#\" class=\"block px-4 py-2 text-sm text-gray-700 hover:bg-bear-100\">中文(简体)</a>\r\n                        <a href=\"#\" class=\"block px-4 py-2 text-sm text-gray-700 hover:bg-bear-100\">English</a>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </header>\r\n\r\n        <!-- 主要注册表单 -->\r\n        <main class=\"flex-1 px-8 md:px-16 flex flex-col items-center justify-center\">\r\n            <div class=\"w-full max-w-md\">\r\n                <!-- 登录/注册标签切换 -->\r\n                <div class=\"flex border-b border-gray-200 mb-8\">\r\n                    <button class=\"py-2 px-1 text-gray-500 hover:text-bear-600 transition-bear\">登录</button>\r\n                    <button class=\"py-2 px-1 ml-6 border-b-2 border-bear-500 text-bear-700 font-medium\">注册</button>\r\n                </div>\r\n\r\n                <!-- 注册表单 -->\r\n                <form class=\"space-y-5\">\r\n                    <!-- 手机号输入框 -->\r\n                    <div>\r\n                        <input type=\"tel\" placeholder=\"手机号码\"\r\n                               class=\"w-full px-4 py-3 rounded-md border border-gray-300 focus:border-bear-500 focus:ring-2 focus:ring-bear-200 outline-none transition-bear\"\r\n                        >\r\n                    </div>\r\n\r\n                    <!-- 密码输入框 -->\r\n                    <div class=\"relative\">\r\n                        <input type=\"password\" placeholder=\"设置密码\"\r\n                               class=\"w-full px-4 py-3 rounded-md border border-gray-300 focus:border-bear-500 focus:ring-2 focus:ring-bear-200 outline-none transition-bear\"\r\n                        >\r\n                        <button type=\"button\" class=\"absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400 hover:text-bear-600 transition-bear\">\r\n                            <i class=\"fa fa-eye-slash\"></i>\r\n                        </button>\r\n                    </div>\r\n\r\n                    <!-- 确认密码输入框 -->\r\n                    <div class=\"relative\">\r\n                        <input type=\"password\" placeholder=\"确认密码\"\r\n                               class=\"w-full px-4 py-3 rounded-md border border-gray-300 focus:border-bear-500 focus:ring-2 focus:ring-bear-200 outline-none transition-bear\"\r\n                        >\r\n                        <button type=\"button\" class=\"absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400 hover:text-bear-600 transition-bear\">\r\n                            <i class=\"fa fa-eye-slash\"></i>\r\n                        </button>\r\n                    </div>\r\n\r\n                    <!-- 小熊ID输入框 -->\r\n                    <div>\r\n                        <select class=\"w-full px-4 py-3 rounded-md border border-gray-300 focus:border-bear-500 focus:ring-2 focus:ring-bear-200 outline-none transition-bear appearance-none bg-white\"\r\n                                aria-label=\"选择身份类型\">\r\n                            <option value=\"\" disabled selected>选择身份类型</option>\r\n                            <option value=\"tenant\">租客</option>\r\n                            <option value=\"landlord\">房东</option>\r\n                        </select>\r\n                    </div>\r\n\r\n                    <!-- 同意条款 -->\r\n                    <div class=\"flex items-start mt-2\">\r\n                        <div class=\"flex items-center h-5\">\r\n                            <input id=\"terms\" type=\"checkbox\" class=\"w-4 h-4 rounded border-gray-300 text-bear-500 focus:ring-bear-500\">\r\n                        </div>\r\n                        <label for=\"terms\" class=\"ml-2 text-sm text-gray-600\">\r\n                            已阅读并同意<a href=\"#\" class=\"text-bear-600 hover:underline\">小熊账号使用协议</a>和<a href=\"#\" class=\"text-bear-600 hover:underline\">隐私政策</a>\r\n                        </label>\r\n                    </div>\r\n\r\n                    <!-- 注册按钮 -->\r\n                    <button type=\"submit\"\r\n                            class=\"w-full py-3 bg-bear-500 hover:bg-bear-600 text-white font-medium rounded-md transition-bear transform hover:translate-y-[-2px] shadow-md hover:shadow-lg\"\r\n                    >\r\n                        注册\r\n                    </button>\r\n\r\n\r\n\r\n\r\n        <!-- 底部版权信息 -->\r\n        <footer class=\"py-6 px-8 md:px-16 text-center text-gray-500 text-sm\">\r\n            <p>© 2023 小熊科技 版权所有</p>\r\n        </footer>\r\n    </div>\r\n</div>\r\n\r\n<!-- 交互脚本 -->\r\n<script>\r\n    // 密码显示/隐藏切换\r\n    document.querySelectorAll('.fa-eye-slash').forEach(icon => {\r\n        icon.parentElement.addEventListener('click', function(e) {\r\n            e.preventDefault();\r\n            const passwordInput = this.previousElementSibling;\r\n            const icon = this.querySelector('i');\r\n\r\n            if (passwordInput.type === 'password') {\r\n                passwordInput.type = 'text';\r\n                icon.classList.remove('fa-eye-slash');\r\n                icon.classList.add('fa-eye');\r\n            } else {\r\n                passwordInput.type = 'password';\r\n                icon.classList.remove('fa-eye');\r\n                icon.classList.add('fa-eye-slash');\r\n            }\r\n        });\r\n    });\r\n\r\n\r\n\r\n\r\n\r\n\r\n</script>\r\n</body>\r\n</html>\r\n

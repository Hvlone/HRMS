<+><!DOCTYPE html>\r\n<html lang=\"zh-CN\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>小熊房屋租赁系统</title>\r\n    <script src=\"https://cdn.tailwindcss.com\"></script>\r\n    <link href=\"https://cdn.jsdelivr.net/npm/font-awesome@4.7.0/css/font-awesome.min.css\" rel=\"stylesheet\">\r\n    <script src=\"https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js\"></script>\r\n\r\n    <!-- 配置Tailwind自定义颜色 - 熊相关配色 -->\r\n    <script>\r\n        tailwind.config = {\r\n            theme: {\r\n                extend: {\r\n                    colors: {\r\n                        // 熊主题颜色\r\n                        bear: {\r\n                            brown: '#8B5A2B',      // 深棕色 - 熊的主要毛色\r\n                            light: '#D2B48C',     // 浅棕色\r\n                            cream: '#F5F5DC',     // 米黄色 - 类似熊的浅色毛发\r\n                            dark: '#5D4037',      // 深棕近黑色\r\n                            honey: '#F9A825',     // 蜂蜜色 - 点缀色\r\n                        }\r\n                    },\r\n                    fontFamily: {\r\n                        sans: ['Inter', 'system-ui', 'sans-serif'],\r\n                    },\r\n                }\r\n            }\r\n        }\r\n    </script>\r\n\r\n    <style type=\"text/tailwindcss\">\r\n        @layer utilities {\r\n            .content-auto {\r\n                content-visibility: auto;\r\n            }\r\n            .shadow-bear {\r\n                box-shadow: 0 4px 6px -1px rgba(93, 64, 55, 0.1), 0 2px 4px -1px rgba(93, 64, 55, 0.06);\r\n            }\r\n            .bg-gradient-bear {\r\n                background-image: linear-gradient(to right, #8B5A2B, #D2B48C);\r\n            }\r\n        }\r\n    </style>\r\n</head>\r\n\r\n<body class=\"bg-bear-cream min-h-screen flex flex-col\">\r\n<!-- 导航栏 -->\r\n<header class=\"bg-bear-brown text-white shadow-md transition-all duration-300\">\r\n    <div class=\"container mx-auto px-4 py-3 flex justify-between items-center\">\r\n        <div class=\"flex items-center space-x-2\">\r\n            <i class=\"fa fa-paw text-2xl text-bear-honey\"></i>\r\n            <h1 class=\"text-xl md:text-2xl font-bold\">小熊房屋租赁系统</h1>\r\n        </div>\r\n\r\n        <!-- 桌面导航 -->\r\n        <nav class=\"hidden md:flex items-center space-x-6\">\r\n            <a href=\"#\" class=\"hover:text-bear-honey transition-colors duration-200 flex items-center\">\r\n                <i class=\"fa fa-home mr-1\"></i> 首页\r\n            </a>\r\n            <a href=\"#\" class=\"hover:text-bear-honey transition-colors duration-200 flex items-center\">\r\n                <i class=\"fa fa-building mr-1\"></i> 房源\r\n            </a>\r\n            <a href=\"#\" class=\"hover:text-bear-honey transition-colors duration-200 flex items-center\">\r\n                <i class=\"fa fa-map-marker mr-1\"></i> 区域\r\n            </a>\r\n            <a href=\"#\" class=\"hover:text-bear-honey transition-colors duration-200 flex items-center\">\r\n                <i class=\"fa fa-info-circle mr-1\"></i> 关于\r\n            </a>\r\n        </nav>\r\n\r\n        <div class=\"flex items-center space-x-4\">\r\n            <button class=\"hidden md:block bg-bear-honey hover:bg-amber-500 text-white px-4 py-2 rounded-lg transition-colors duration-200\">\r\n                <i class=\"fa fa-user-plus mr-1\"></i> 注册\r\n            </button>\r\n            <button class=\"hidden md:block bg-transparent border border-white hover:border-bear-honey hover:text-bear-honey px-4 py-2 rounded-lg transition-colors duration-200\">\r\n                <i class=\"fa fa-sign-in mr-1\"></i> 登录\r\n            </button>\r\n\r\n            <!-- 移动端菜单按钮 -->\r\n            <button class=\"md:hidden text-white focus:outline-none\" id=\"menuBtn\">\r\n                <i class=\"fa fa-bars text-xl\"></i>\r\n            </button>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- 移动端导航菜单 -->\r\n    <div class=\"md:hidden hidden bg-bear-dark\" id=\"mobileMenu\">\r\n        <div class=\"container mx-auto px-4 py-3 flex flex-col space-y-3\">\r\n            <a href=\"#\" class=\"text-white hover:text-bear-honey py-2 transition-colors duration-200\">\r\n                <i class=\"fa fa-home mr-2\"></i> 首页\r\n            </a>\r\n            <a href=\"#\" class=\"text-white hover:text-bear-honey py-2 transition-colors duration-200\">\r\n                <i class=\"fa fa-building mr-2\"></i> 房源\r\n            </a>\r\n            <a href=\"#\" class=\"text-white hover:text-bear-honey py-2 transition-colors duration-200\">\r\n                <i class=\"fa fa-map-marker mr-2\"></i> 区域\r\n            </a>\r\n            <a href=\"#\" class=\"text-white hover:text-bear-honey py-2 transition-colors duration-200\">\r\n                <i class=\"fa fa-info-circle mr-2\"></i> 我的\r\n            </a>\r\n            <div class=\"flex space-x-2 pt-2 border-t border-bear-light/30\">\r\n                <button class=\"flex-1 bg-bear-honey hover:bg-amber-500 text-white px-4 py-2 rounded-lg transition-colors duration-200\">\r\n                    <i class=\"fa fa-user-plus mr-1\"></i> 注册\r\n                </button>\r\n                <button class=\"flex-1 bg-transparent border border-white hover:border-bear-honey hover:text-bear-honey px-4 py-2 rounded-lg transition-colors duration-200\">\r\n                    <i class=\"fa fa-sign-in mr-1\"></i> 登录\r\n                </button>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</header>\r\n\r\n<!-- 主横幅 -->\r\n<section class=\"relative bg-bear-dark text-white py-12 md:py-20\">\r\n    <div class=\"absolute inset-0 opacity-20\">\r\n        <img src=\"https://picsum.photos/id/1048/1920/1080\" alt=\"温馨的房屋内部\" class=\"w-full h-full object-cover\" />\r\n    </div>\r\n    <div class=\"container mx-auto px-4 relative z-10\">\r\n        <div class=\"max-w-2xl\">\r\n            <h2 class=\"text-3xl md:text-5xl font-bold mb-4 leading-tight\">找到属于你的温馨小窝</h2>\r\n            <p class=\"text-lg md:text-xl mb-8 text-bear-cream/90\">小熊房屋租赁系统帮您轻松找到理想的租赁房源，安全、可靠、便捷</p>\r\n\r\n            <!-- 搜索框 -->\r\n            <div class=\"bg-white rounded-lg shadow-lg p-2 flex flex-col md:flex-row gap-2\">\r\n                <div class=\"flex-1 relative\">\r\n                    <i class=\"fa fa-search absolute left-3 top-1/2 transform -translate-y-1/2 text-bear-dark/50\"></i>\r\n                    <input type=\"text\" placeholder=\"搜索区域、小区或地址\" class=\"w-full pl-10 pr-4 py-3 rounded-md border border-gray-200 focus:outline-none focus:ring-2 focus:ring-bear-brown/50 focus:border-bear-brown\" />\r\n                </div>\r\n                <div class=\"flex-1 relative\">\r\n                    <i class=\"fa fa-filter absolute left-3 top-1/2 transform -translate-y-1/2 text-bear-dark/50\"></i>\r\n                    <select class=\"w-full pl-10 pr-10 py-3 rounded-md border border-gray-200 appearance-none focus:outline-none focus:ring-2 focus:ring-bear-brown/50 focus:border-bear-brown bg-white\">\r\n                        <option value=\"\">所有户型</option>\r\n                        <option value=\"1\">一室</option>\r\n                        <option value=\"2\">二室</option>\r\n                        <option value=\"3\">三室</option>\r\n                        <option value=\"4+\">四室及以上</option>\r\n                    </select>\r\n                    <i class=\"fa fa-chevron-down absolute right-3 top-1/2 transform -translate-y-1/2 text-bear-dark/50 pointer-events-none\"></i>\r\n                </div>\r\n                <button class=\"bg-bear-brown hover:bg-bear-dark text-white px-6 py-3 rounded-md transition-colors duration-200 whitespace-nowrap\">\r\n                    <i class=\"fa fa-search mr-2\"></i> 搜索房源\r\n                </button>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</section>\r\n\r\n<!-- 主要内容 -->\r\n<main class=\"flex-grow container mx-auto px-4 py-8\">\r\n    <!-- 统计数据 -->\r\n    <section class=\"grid grid-cols-2 m